{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novaai-landing",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets: serves the compiled React Vite frontend from dist directory
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Observability & Logs
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },

  // Cloudflare D1 Database binding
  // Create your D1 database with: npx wrangler d1 create novaai-db
  // Then replace the database_id below
  "d1_databases": [
    {
      "binding": "novaai-db",
      "database_name": "novaai-d1",
      "database_id": "53465fb4-362d-488a-bdfb-7004a647482c",
      "migrations_table": "d1_migrations",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare R2 Storage binding (optional for files/media)
  // Create your R2 bucket with: npx wrangler r2 bucket create novaai-storage
  "r2_buckets": [
    {
      "binding": "novaai-bucket",
      "bucket_name": "novaai-r2"
    }
  ],

  // Cloudflare Environment Variables & Secrets
  "vars": {
    "ENVIRONMENT": "production"
  }
}
