{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novaai-landing",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets: serves the compiled React Vite frontend from dist directory
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Observability & Logs
  "observability": {
    "enabled": true
  },

  // Cloudflare D1 Database binding
  // Create your D1 database with: npx wrangler d1 create novaai-db
  // Then replace the database_id below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novaai-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_table": "d1_migrations",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare R2 Storage binding (optional for files/media)
  // Create your R2 bucket with: npx wrangler r2 bucket create novaai-storage
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "novaai-storage"
    }
  ],

  // Cloudflare Environment Variables & Secrets
  "vars": {
    "ENVIRONMENT": "production"
  }
}
